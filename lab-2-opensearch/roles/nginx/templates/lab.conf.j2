server {
    listen 80 default_server;
    server_name _;
    root {{ nginx_site_root }};
    index index.html;

    access_log {{ nginx_log }} json_lab;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /api/status {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }
}
