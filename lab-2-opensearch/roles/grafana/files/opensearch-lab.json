                  "color": "green"
                },
                "1": {
                  "text": "YELLOW",
                  "color": "yellow"
                },
                "2": {
                  "text": "RED",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
