[SERVICE]
    Flush        1
    Log_Level    info
    Parsers_File /etc/fluent-bit/parsers-lab.conf
    HTTP_Server  On
    HTTP_Listen  127.0.0.1
    HTTP_Port    2020

# JSON-журнал nginx; позиция чтения хранится в БД и переживает перезапуск
[INPUT]
    Name             tail
    Tag              nginx.access
    Path             {{ nginx_log }}
    Parser           nginx_json
    DB               /var/lib/fluent-bit/nginx.db
    Read_from_Head   On
    Refresh_Interval 5

[FILTER]
    Name   record_modifier
    Match  nginx.*
    Record server {{ inventory_hostname }}

# data stream принимает только операцию create
[OUTPUT]
    Name               opensearch
    Match              nginx.*
    Host               {{ groups['hot'][0] }}
    Port               {{ opensearch_http_port }}
    HTTP_User          {{ logs_writer_user }}
    HTTP_Passwd        {{ logs_writer_password }}
    Index              {{ logs_data_stream }}
    Write_Operation    create
    Suppress_Type_Name On
    Logstash_Format    Off
    Time_Key           @timestamp
    tls                On
    tls.verify         On
    tls.ca_file        {{ ca_cert_path }}
    Retry_Limit        10
    Trace_Error        On
